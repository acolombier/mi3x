// Autonomously generated by an AI agent; subject to human review.
import QtQuick
import QtQuick.Layouts
import QtQuick.Controls
import QtQuick.Dialogs
import Mixxx 1.0 as Mixxx
import ".." as Skin
import "." as SettingComponents
import "../Theme"

Category {
    id: root

    property var cfg: store.values
    property bool dirty: false

    // The controls are dynamic per output format: losslessly recorded
    // tracks hide the bitrate controls, FLAC swaps the quality slider for
    // a compression slider, and the tracklist comment is only supported
    // for MP3 and WAV.
    readonly property bool isFlac: cfg.format === "FLAC"
    readonly property bool isLossless: ["WAV PCM", "AIFF PCM", "FLAC"].indexOf(cfg.format) > -1
    readonly property bool isRecording: Mixxx.Recording && Mixxx.Recording?.durationText !== "--:--" // FIXME: proxy not yet merged
    readonly property bool isWavOrMp3: cfg.format === "MP3" || cfg.format === "WAV PCM"

    function load() {
        // Copy the store so that control bindings re-evaluate on reload.
        cfg = Object.assign({}, store.values);
        root.dirty = false;
        errorMessage.text = "";
    }
    function reset() {
        store.reset();
        load();
    }
    function save() {
        if (!cfg.directory) {
            errorMessage.text = "A recording directory is required";
            return;
        }
        console.log("Save recording configuration:", JSON.stringify(cfg));
        root.dirty = false;
        load();
    }
    function set(field, value) {
        if (cfg[field] === value) {
            return;
        }
        cfg[field] = value;
        root.dirty = true;
    }

    label: "Recording"

    Component.onCompleted: {
        root.load();
    }

    // TODO(XXX): mock backend. While no C++ proxy for the recording
    // settings is available in QML yet, values are kept in memory only.
    // Replace with real bindings to the [Recording] config keys and
    // EncoderFactory later, keeping this load()/save() contract.
    QtObject {
        id: store

        property var values: ({
                album: "",
                author: "",
                bitrateMode: "CBR",
                channels: "Stereo",
                compression: 5,
                cueAnnotation: "off",
                cueFile: "on",
                directory: "/home/antoine/Music/Recordings",
                format: "MP3",
                quality: 128,
                split: "4 GB",
                title: "",
                tracklistAsComment: "on"
            })

        function reset() {
            values = Object.assign({}, values, {
                album: "",
                author: "",
                bitrateMode: "CBR",
                channels: "Stereo",
                compression: 5,
                cueAnnotation: "off",
                cueFile: "on",
                format: "MP3",
                quality: 128,
                split: "4 GB",
                title: "",
                tracklistAsComment: "on"
            });
        }
    }

    // Invisible stand-in for the native folder picker so behavior tests can
    // inject a directory the same way as on the Library page. Mirrors the
    // testDialog mock from Library.qml.
    Item {
        id: testFolderDialog

        property int openCount: 0
        property url selectedFolder: root.cfg.directory
        property bool testMode: false

        function open() {
            openCount++;
            if (testMode) {
                root.set("directory", selectedFolder.toString());
            } else {
                folderDialog.open();
            }
        }

        height: 0
        objectName: "recordingFolderDialogTest"
        visible: false
        width: 0
    }
    FolderDialog {
        id: folderDialog

        currentFolder: root.cfg.directory
        title: "Choose a recording directory"

        onAccepted: root.set("directory", selectedFolder)
    }
    ScrollView {
        id: scrollView

        anchors.bottom: buttonActions.top
        anchors.bottomMargin: 18
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top

        ColumnLayout {
            spacing: 0
            width: scrollView.width

            // Read-only recording state indicator: session recording is
            // toggled from the main window, never from settings.
            RowLayout {
                Layout.bottomMargin: 10
                Layout.leftMargin: 17
                Layout.topMargin: 14
                visible: root.isRecording

                Rectangle {
                    color: "#7D3B3B"
                    implicitHeight: recordingStateText.implicitHeight + 10
                    implicitWidth: recordingStateText.implicitWidth + 20
                    radius: 4

                    Text {
                        id: recordingStateText

                        anchors.centerIn: parent
                        color: Theme.white
                        font.pixelSize: 12
                        font.weight: Font.DemiBold
                        objectName: "recordingState"

                        // text: "RECORDING ..." placeholder until the
                        // Mixxx.Recording proxy singleton is available.
                        text: Mixxx.Recording ? "RECORDING " + Mixxx.Recording.durationText : "RECORDING ..."
                    }
                }
            }

            // --- Recording files ------------------------------------------------
            Mixxx.SettingGroup {
                id: filesGroup

                Layout.bottomMargin: 6
                Layout.fillWidth: true
                implicitHeight: filesPane.implicitHeight + 20
                label: "Recording files"

                Rectangle {
                    anchors.left: parent.left
                    anchors.right: parent.right
                    color: Qt.alpha('#676767', 0.21)
                    implicitHeight: filesPane.implicitHeight + 20

                    // 4 columns on wide panes, collapsing to 2 columns when
                    // narrower (mirrors the Library metadata pane pattern).
                    GridLayout {
                        id: filesPane

                        anchors.bottomMargin: 10
                        anchors.fill: parent
                        anchors.leftMargin: 17
                        anchors.rightMargin: 17
                        anchors.topMargin: 10
                        columnSpacing: 48
                        columns: filesPane.width < 900 ? 1 : 2
                        objectName: "recordingFilesGrid"
                        rowSpacing: 15
                        uniformCellWidths: true

                        RowLayout {
                            Mixxx.SettingParameter {
                                Layout.minimumWidth: directoryLabel.implicitWidth
                                Layout.alignment: Qt.AlignVCenter
                                Layout.fillWidth: true
                                label: "Directory"

                                Text {
                                    id: directoryLabel
                                    anchors.top: parent.top
                                    anchors.bottom: parent.bottom
                                    color: Theme.white
                                    elide: Text.ElideRight
                                    font.pixelSize: 14
                                    font.weight: Font.Medium
                                    horizontalAlignment: Text.AlignLeft
                                    text: parent.label
                                    verticalAlignment: Text.AlignVCenter
                                }
                            }
                            RowLayout {
                                Layout.minimumHeight: 26
                                Layout.minimumWidth: 100
                                Layout.maximumWidth: 300
                                Skin.InputField {
                                    input.text: root.cfg.directory
                                    objectName: "recordingDirectory"
                                    Layout.fillWidth: true
                                    Layout.minimumHeight: 26

                                    input.onAccepted: {
                                        root.set("directory", input.text);
                                        input.focus = false;
                                    }
                                }
                                Skin.FormButton {
                                    activeColor: "#999999"
                                    backgroundColor: "#3F3F3F"
                                    objectName: "recordingBrowseButton"
                                    text: "Browse..."

                                    onPressed: testFolderDialog.open()
                                }
                            }
                        }

                        RowLayout {
                            Mixxx.SettingParameter {
                                Layout.minimumWidth: qualityLabel.implicitWidth
                                Layout.alignment: Qt.AlignVCenter
                                Layout.fillWidth: true
                                label: "Quality"

                                Text {
                                    id: qualityLabel
                                    anchors.top: parent.top
                                    anchors.bottom: parent.bottom
                                    color: Theme.white
                                    elide: Text.ElideRight
                                    font.pixelSize: 14
                                    font.weight: Font.Medium
                                    horizontalAlignment: Text.AlignLeft
                                    text: parent.label
                                    verticalAlignment: Text.AlignVCenter
                                }
                            }
                            SettingComponents.Slider {
                                id: qualityRow
                                Layout.preferredWidth: 350
                                Layout.preferredHeight: 30

                                markers: [32, 96, 128, 192, 256, 320]
                                objectName: "recordingQuality"
                                suffix: " kbit/s"
                                value: root.cfg.quality ?? 128

                                onValueChanged: {
                                    if (!visible) {
                                        return;
                                    }
                                    root.set("quality", value);
                                }
                            }
                        }

                        RowLayout {
                            Mixxx.SettingParameter {
                                Layout.minimumWidth: outputFileFormatLabel.implicitWidth
                                Layout.alignment: Qt.AlignVCenter
                                Layout.fillWidth: true
                                label: "Output file format"
                                keywords: [
                                    "channels"
                                ]

                                Text {
                                    id: outputFileFormatLabel
                                    anchors.top: parent.top
                                    anchors.bottom: parent.bottom
                                    color: Theme.white
                                    elide: Text.ElideRight
                                    font.pixelSize: 14
                                    font.weight: Font.Medium
                                    horizontalAlignment: Text.AlignLeft
                                    text: parent.label
                                    verticalAlignment: Text.AlignVCenter
                                }
                            }
                            RowLayout {
                                Layout.fillWidth: true
                                Skin.ComboBox {
                                    // Values mirror EncoderFactory::getFormats().
                                    // TODO(XXX): populate from the encoder registry
                                    // when it becomes available to QML.
                                    currentIndex: ["WAV PCM", "AIFF PCM", "FLAC", "MP3", "OGG Vorbis", "Opus", "AAC", "HE-AAC", "HE-AACv2"].indexOf(root.cfg.format)
                                    model: ["WAV PCM", "AIFF PCM", "FLAC", "MP3", "OGG Vorbis", "Opus", "AAC", "HE-AAC", "HE-AACv2"]
                                    objectName: "recordingFormat"

                                    onActivated: function (index) {
                                        root.set("format", currentText);
                                    }
                                }
                                RatioChoice {
                                    inactiveColor: Theme.darkGray4
                                    maxWidth: filesPane.width * 0.5
                                    objectName: "recordingChannels"
                                    options: ["Stereo", "Mono"]
                                    selected: root.cfg.channels

                                    onSelectedChanged: root.set("channels", selected)
                                }
                            }
                        }
                        RowLayout {
                            Mixxx.SettingParameter {
                                Layout.minimumWidth: splitRecordingsLabel.implicitWidth
                                Layout.alignment: Qt.AlignVCenter
                                Layout.fillWidth: true
                                label: "Split recordings at"

                                Text {
                                    id: splitRecordingsLabel
                                    anchors.top: parent.top
                                    anchors.bottom: parent.bottom
                                    color: Theme.white
                                    elide: Text.ElideRight
                                    font.pixelSize: 14
                                    font.weight: Font.Medium
                                    horizontalAlignment: Text.AlignLeft
                                    text: parent.label
                                    verticalAlignment: Text.AlignVCenter
                                }
                            }
                            Skin.ComboBox {
                                // Values mirror DlgPrefRecord's splitting combo.
                                currentIndex: ["650 MB", "700 MB (CD)", "1 GB", "2 GB", "4 GB", "60 Minutes (CD)", "74 Minutes (CD)", "80 Minutes (CD)", "120 Minutes", "No Splitting"].indexOf(root.cfg.split)
                                model: ["650 MB", "700 MB (CD)", "1 GB", "2 GB", "4 GB", "60 Minutes (CD)", "74 Minutes (CD)", "80 Minutes (CD)", "120 Minutes", "No Splitting"]
                                objectName: "recordingSplitting"

                                onActivated: function (index) {
                                    // "No Splitting" is not supported by
                                    // lossless formats in the legacy page.
                                    if (root.isLossless && currentText === "No Splitting") {
                                        currentIndex = ["650 MB", "700 MB (CD)", "1 GB", "2 GB", "4 GB", "60 Minutes (CD)", "74 Minutes (CD)", "80 Minutes (CD)", "120 Minutes", "No Splitting"].indexOf(root.cfg.split);
                                        return;
                                    }
                                    root.set("split", currentText);
                                }
                            }
                        }
                        RowLayout {
                            Mixxx.SettingParameter {
                                Layout.minimumWidth: bitrateModeLabel.implicitWidth
                                Layout.alignment: Qt.AlignVCenter
                                Layout.fillWidth: true
                                label: "Bitrate mode"

                                Text {
                                    id: bitrateModeLabel
                                    anchors.top: parent.top
                                    anchors.bottom: parent.bottom
                                    color: Theme.white
                                    elide: Text.ElideRight
                                    font.pixelSize: 14
                                    font.weight: Font.Medium
                                    horizontalAlignment: Text.AlignLeft
                                    text: parent.label
                                    verticalAlignment: Text.AlignVCenter
                                }
                            }
                            RatioChoice {
                                id: bitrateModeRow

                                inactiveColor: Theme.darkGray4
                                maxWidth: filesPane.width * 0.5
                                objectName: "recordingBitrateMode"
                                options: ["CBR", "ABR", "VBR"]
                                selected: root.cfg.bitrateMode

                                onSelectedChanged: root.set("bitrateMode", selected)
                            }
                        }
                        RowLayout {
                            Mixxx.SettingParameter {
                                Layout.minimumWidth: compressionLevelLabel.implicitWidth
                                Layout.alignment: Qt.AlignVCenter
                                Layout.fillWidth: true
                                label: "Compression level"

                                Text {
                                    id: compressionLevelLabel
                                    anchors.top: parent.top
                                    anchors.bottom: parent.bottom
                                    color: Theme.white
                                    elide: Text.ElideRight
                                    font.pixelSize: 14
                                    font.weight: Font.Medium
                                    horizontalAlignment: Text.AlignLeft
                                    text: parent.label
                                    verticalAlignment: Text.AlignVCenter
                                }
                            }
                            SettingComponents.Slider {
                                id: compressionRow
                                Layout.preferredWidth: 350
                                Layout.preferredHeight: 30

                                markers: [0, 2, 4, 6, 8]
                                objectName: "recordingCompression"
                                suffix: ""
                                value: root.cfg.compression ?? 5

                                onValueChanged: {
                                    if (!visible) {
                                        return;
                                    }
                                    root.set("compression", Math.round(value));
                                }
                            }
                        }
                        RowLayout {
                            Mixxx.SettingParameter {
                                Layout.minimumWidth: cueFileLabel.implicitWidth
                                Layout.alignment: Qt.AlignVCenter
                                Layout.fillWidth: true
                                label: "CUE file"
                                keywords: [
                                    "annotation"
                                ]

                                Text {
                                    id: cueFileLabel
                                    anchors.top: parent.top
                                    anchors.bottom: parent.bottom
                                    color: Theme.white
                                    elide: Text.ElideRight
                                    font.pixelSize: 14
                                    font.weight: Font.Medium
                                    horizontalAlignment: Text.AlignLeft
                                    text: parent.label
                                    verticalAlignment: Text.AlignVCenter
                                }
                            }
                            RatioChoice {
                                inactiveColor: Theme.darkGray4
                                // maxWidth: filesPane.width * 0.5
                                objectName: "recordingCueFile"
                                options: ["with file annotation", "on", "off"]
                                selected: root.cfg.cueFile

                                onSelectedChanged: root.set("cueFile", selected)
                            }
                        }
                        RowLayout {
                            Mixxx.SettingParameter {
                                Layout.minimumWidth: trackListAsCommentLabel.implicitWidth
                                Layout.alignment: Qt.AlignVCenter
                                Layout.fillWidth: true
                                label: "Store the tracklist as comment"

                                Text {
                                    id: trackListAsCommentLabel
                                    anchors.top: parent.top
                                    anchors.bottom: parent.bottom
                                    color: Theme.white
                                    elide: Text.ElideRight
                                    font.pixelSize: 14
                                    font.weight: Font.Medium
                                    horizontalAlignment: Text.AlignLeft
                                    text: parent.label
                                    verticalAlignment: Text.AlignVCenter
                                }
                            }
                            RatioChoice {
                                id: tracklistAsCommentRow

                                enabled: root.isWavOrMp3
                                inactiveColor: Theme.darkGray4
                                maxWidth: filesPane.width * 0.5
                                objectName: "recordingTracklistAsComment"
                                options: ["on", "off"]
                                selected: root.cfg.tracklistAsComment

                                onSelectedChanged: root.set("tracklistAsComment", selected)
                            }
                        }
                    }
                }
            }

            // --- Tags -------------------------------------------------------------
            RowLayout {
                Text {
                    Layout.bottomMargin: 14
                    Layout.leftMargin: 17
                    Layout.topMargin: 10
                    color: Theme.white
                    font.pixelSize: 16
                    font.weight: Font.DemiBold
                    text: "Tags"
                }
            }
            Mixxx.SettingGroup {
                id: tagsGroup

                Layout.bottomMargin: 6
                Layout.fillWidth: true
                implicitHeight: tagsPane.implicitHeight + 20
                label: "Tags"

                Rectangle {
                    anchors.left: parent.left
                    anchors.right: parent.right
                    color: Qt.alpha('#676767', 0.21)
                    implicitHeight: tagsPane.implicitHeight + 20

                    GridLayout {
                        id: tagsPane

                        anchors.bottomMargin: 10
                        anchors.fill: parent
                        anchors.leftMargin: 17
                        anchors.rightMargin: 17
                        anchors.topMargin: 10
                        columnSpacing: 100
                        columns: 2
                        objectName: "recordingTagsGrid"
                        rowSpacing: 15

                        Mixxx.SettingParameter {
                            Layout.minimumWidth: titleLabel.implicitWidth
                            Layout.alignment: Qt.AlignVCenter
                            label: "Title"

                            Text {
                                id: titleLabel
                                anchors.top: parent.top
                                anchors.bottom: parent.bottom
                                color: Theme.white
                                elide: Text.ElideRight
                                font.pixelSize: 14
                                font.weight: Font.Medium
                                horizontalAlignment: Text.AlignLeft
                                text: parent.label
                                verticalAlignment: Text.AlignVCenter
                            }
                        }
                        Skin.InputField {
                            Layout.fillWidth: true
                            Layout.minimumHeight: 26
                            input.text: root.cfg.title
                            objectName: "recordingTitleTag"

                            input.onAccepted: {
                                root.set("title", input.text);
                                input.focus = false;
                            }
                        }

                        Mixxx.SettingParameter {
                            Layout.minimumWidth: authorLabel.implicitWidth
                            Layout.alignment: Qt.AlignVCenter
                            label: "Author"

                            Text {
                                id: authorLabel
                                anchors.top: parent.top
                                anchors.bottom: parent.bottom
                                color: Theme.white
                                elide: Text.ElideRight
                                font.pixelSize: 14
                                font.weight: Font.Medium
                                horizontalAlignment: Text.AlignLeft
                                text: parent.label
                                verticalAlignment: Text.AlignVCenter
                            }
                        }
                        Skin.InputField {
                            Layout.fillWidth: true
                            Layout.minimumHeight: 26
                            input.text: root.cfg.author
                            objectName: "recordingAuthorTag"

                            input.onAccepted: {
                                root.set("author", input.text);
                                input.focus = false;
                            }
                        }
                        Mixxx.SettingParameter {
                            Layout.minimumWidth: albumLabel.implicitWidth
                            Layout.alignment: Qt.AlignVCenter
                            label: "Album"

                            Text {
                                id: albumLabel
                                anchors.top: parent.top
                                anchors.bottom: parent.bottom
                                color: Theme.white
                                elide: Text.ElideRight
                                font.pixelSize: 14
                                font.weight: Font.Medium
                                horizontalAlignment: Text.AlignLeft
                                text: parent.label
                                verticalAlignment: Text.AlignVCenter
                            }
                        }
                        Skin.InputField {
                            Layout.fillWidth: true
                            Layout.minimumHeight: 26
                            input.text: root.cfg.album
                            objectName: "recordingAlbumTag"

                            input.onAccepted: {
                                root.set("album", input.text);
                                input.focus = false;
                            }
                        }
                    }
                }
            }
        }
    }
    RowLayout {
        id: buttonActions

        anchors.bottom: root.bottom
        anchors.bottomMargin: 20
        anchors.left: parent.left
        anchors.leftMargin: 14
        anchors.right: parent.right
        anchors.rightMargin: 14

        Skin.FormButton {
            activeColor: "#999999"
            backgroundColor: "#7D3B3B"
            objectName: "recordingResetButton"
            opacity: enabled ? 1.0 : 0.5
            text: "Reset"

            onPressed: root.reset()
        }
        Item {
            Layout.fillWidth: true
        }
        Text {
            id: errorMessage

            Layout.alignment: Qt.AlignVCenter
            Layout.rightMargin: 16
            color: "#7D3B3B"
            text: ""
        }
        Skin.FormButton {
            activeColor: "#999999"
            backgroundColor: "#3F3F3F"
            objectName: "recordingCancelButton"
            opacity: enabled ? 1.0 : 0.5
            text: "Cancel"
            visible: root.dirty

            onPressed: root.load()
        }
        Skin.FormButton {
            activeColor: "#999999"
            backgroundColor: root.dirty ? "#3a60be" : "#3F3F3F"
            enabled: pressed || root.dirty
            objectName: "recordingSaveButton"
            opacity: enabled ? 1.0 : 0.5
            text: "Save"

            onPressed: {
                errorMessage.text = "";
                root.save();
            }
        }
    }
}
